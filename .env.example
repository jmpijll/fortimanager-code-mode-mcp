# FortiManager connection settings
FMG_HOST=https://fortimanager.example.com
FMG_PORT=443
FMG_API_TOKEN=your-api-token-here
FMG_VERIFY_SSL=true

# API version (7.4 or 7.6)
FMG_API_VERSION=7.6

# MCP transport mode (http or stdio)
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=http)
MCP_HTTP_PORT=8000

# ─── Optional auth for the HTTP transport ──────────────────────────────────
# Both settings are HTTP-only — stdio is single-process and not network-facing.
#
# If set, every request to /mcp must include `Authorization: Bearer <MCP_API_KEY>`.
# Missing / wrong tokens get 401. Unset means the endpoint is open (default).
# MCP_API_KEY=change-me-to-a-long-random-string
#
# If true, the transport reads `X-FMG-Token: <token>` from each /mcp request
# and uses that token (instead of FMG_API_TOKEN) for FortiManager calls
# made from the sandboxed `execute` tool. Lets each MCP client supply its
# own FMG admin credential so FMG's own RBAC enforces per-user permissions.
# Requests without the header fall back to FMG_API_TOKEN, so existing
# single-tenant deployments keep working. Defaults to false.
# MCP_TOKEN_PASSTHROUGH=false
