{
  "name": "fortimanager-code-mode-mcp",
  "version": "2.0.0",
  "description": "MCP server for FortiManager using Code Mode pattern — 2 tools (search + execute) with QuickJS WASM sandbox",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fortimanager-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "!dist/spec",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');const s=p.join('src','spec');const d=p.join('dist','spec');fs.mkdirSync(d,{recursive:true});if(fs.existsSync(s)){fs.readdirSync(s).filter(f=>f.endsWith('.json')).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)))}else{console.warn('WARN: src/spec/ not found — run npm run generate:spec to generate API specs')}\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src scripts vitest.config.ts",
    "lint:fix": "eslint src scripts vitest.config.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:spec": "tsx scripts/generate-spec.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "fortimanager",
    "fortinet",
    "mcp",
    "model-context-protocol",
    "code-mode",
    "json-rpc"
  ],
  "author": "Jamie van der Pijll <jamiehakker@hotmail.com> (https://github.com/jmpijll)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmpijll/fortimanager-code-mode-mcp.git"
  },
  "homepage": "https://github.com/jmpijll/fortimanager-code-mode-mcp#readme",
  "bugs": {
    "url": "https://github.com/jmpijll/fortimanager-code-mode-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "cheerio": "^1.0.0",
    "quickjs-emscripten": "^0.32.0",
    "undici": "^8.11.2",
    "zod": "^4.2.0"
  }
}
